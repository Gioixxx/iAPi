# Copia in deploy/.env (gitignored) e adatta. I valori sostituiscono le ${VAR} in docker-compose.yml.
IAPI_VERSION=latest          # o un semver pinnato (es. 0.1.0) per congelare/fare rollback
IAPI_PORT=8000
LOG_LEVEL=INFO

# Backend di inferenza: ollama (default, container nel compose) | lmstudio (server esterno)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_IMAGE_TAG=0.32.0      # verificato via `docker pull ollama/ollama:latest` il 2026-07-16 — ricontrollare su hub.docker.com/r/ollama/ollama/tags prima del deploy se passa tempo

# --- LM Studio (usato solo con LLM_PROVIDER=lmstudio, richiede LM Studio/llmster >= 0.4.0) ---
LMSTUDIO_BASE_URL=http://host.docker.internal:1234   # llmster sull'host del Pi; per un'altra macchina: http://<ip>:1234
LMSTUDIO_MODEL=google/gemma-4-e2b                    # chiave del catalogo LM Studio, scaricata in automatico se manca
LMSTUDIO_API_TOKEN=                                  # consigliato se il server LM Studio ascolta su 0.0.0.0
LMSTUDIO_REASONING_EFFORT=none                       # none = niente "thinking" (più veloce); vuoto = non inviato

# Timeout di generazione, vale per entrambi i provider (nome storico)
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
